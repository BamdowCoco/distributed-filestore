[rpc_server]
# rpc节点ip地址
rpc_server_ip=127.0.0.1
# rpc节点端口号
rpc_server_port=8003

[zookeeper]
# zookeeper的ip地址
zookeeper_ip=127.0.0.1
# zookeeper的端口号
zookeeper_port=2181

[storage_nodes]
# 存储节点列表，逗号分隔 ip:port（仅作启动时的种子，运行期由 ZK 动态发现覆盖）
storage_nodes=127.0.0.1:8001,127.0.0.1:8002

[gc]
# 孤儿块对账周期（秒）。每个周期只处理一个 id 区间 [游标, 游标+gc_range_width)，
# 逐周期把游标往前推，多轮合起来覆盖全域。
# 调大更省资源，调小回收更快；验证时可临时调成 10。
gc_interval_sec=600
# 每轮推进的 id 区间宽度。它同时是「每轮读多少 DB 行、每节点扫多少 id」的上界：
# 调小则单轮更轻、但覆盖全部 file_id 需要的轮数更多；调大则相反。
gc_range_width=10000

[auth]
# 票据签发私钥（Ed25519）的 PEM 文件路径。私钥只有元数据服务需要——存储节点只持公钥，
# 因此一台存储节点被攻破也拿不到签发能力。
# 生成密钥对：./bin/ticket_keygen config/keys
# **私钥是机密**：权限 0600，放在仓库外或 config/keys/（已 gitignore），不要提交。
# 也可用环境变量 MPRPC_TICKET_PRIVKEY 覆盖（给的是路径，不是密钥本身）。
ticket_privkey=config/keys/ticket_priv.pem
