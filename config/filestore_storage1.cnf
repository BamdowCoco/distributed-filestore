[rpc_server]
# rpc节点ip地址
rpc_server_ip=127.0.0.1
# rpc节点端口号
rpc_server_port=8001

[zookeeper]
# zookeeper的ip地址
zookeeper_ip=127.0.0.1
# zookeeper的端口号
zookeeper_port=2181

[storage]
# 本存储节点的数据落盘目录
data_dir=filestore/data_node1

[auth]
# 可信票据公钥（Ed25519）的 PEM 文件路径。公钥**不是机密**，写在本文件里是安全的——
# 这正是改用非对称签名的收益：需要保密的只有元数据服务那一把私钥。
# 轮换过渡期可逗号分隔多把（新旧并存），待旧票据全部过期后再摘掉旧的。
# 可用环境变量 MPRPC_TICKET_PUBKEY 覆盖。
ticket_pubkey=config/keys/ticket_pub.pem
